RPG_Station_Sawmill.name = Aserradero
RPG_Station_Sawmill.description = Sirve para serrar troncos y sacar tablones. Un hacha mejor saca más tablones de cada tronco.
RPG_Station_Sawmill.hint.empty = Pulsa [{key}] para cargar troncos
RPG_Station_Sawmill.hint.loaded = Pulsa [{key}] para trabajar
RPG_Station_MountSpike.name = Mount Spike (Dev)
RPG_Station_MountSpike.description = Spike de desarrollo desechable: verifica la pose de trabajo de pie con montura de entidad.
RPG_Station_MountSpike.hint.empty = Pulsa [{key}] para cargar troncos
RPG_Station_MountSpike.hint.loaded = Pulsa [{key}] para trabajar
RPG_Station_CuttingBoard.name = Tabla de Corte
RPG_Station_CuttingBoard.description = Una estación de trabajo que limpia escamas de peces y los prepara para cocinar.
RPG_Station_CuttingBoard.hint.empty = Pulsa [{key}] para cargar peces
RPG_Station_CuttingBoard.hint.loaded = Pulsa [{key}] para trabajar
RPG_Station_CookingFire.name = Fuego de Cocina
RPG_Station_CookingFire.description = Un fuego de campamento que asa peces crudos.
RPG_Station_CookingFire.hint.empty = Pulsa [{key}] para cargar peces crudos
RPG_Station_CookingFire.hint.loaded = Pulsa [{key}] para trabajar

RPG_Tool_Hatchet_Sawmiller.name = Hacha del Aserrador
RPG_Tool_Hatchet_Sawmiller.description = Un hacha de mitril magistral, equilibrada por incontables horas en el aserradero. Más afilada y resistente que la original de forja.
RPG_Station_CookingPit.name = Fogón de Cocina
RPG_Station_CookingPit.description = Un fuego de campamento rodeado de piedra. Asa alimentos crudos sobre la llama o monta una olla encima para cocinar comidas completas.
RPG_Station_CookingPit.hint.empty = Pulsa [{key}] para cocinar
RPG_Station_CookingPit.hint.loaded = Pulsa [{key}] para trabajar
RPG_Station_CookingPit.hint.ready = Pulsa [{key}] para recoger
RPG_Station_CookingPit.hint.overdone = Pulsa [{key}] para limpiar
RPG_Station_Cooking_Pot.name = Olla de Cocina
RPG_Station_Cooking_Pot.description = Una olla de hierro resistente. Colócala justo encima de un fogón de cocina para poder guisar.
RPG_Food_Hearty_Stew.name = Guiso Sustancioso
RPG_Food_Hearty_Stew.description = Un cuenco con todo lo que cayó en la olla, cocido a fuego lento hasta que combina. Restaura salud; una buena mezcla de carne y verduras fortalece la salud y el aguante a la vez.
RPG_Station_Disenchanting_Table.name = Mesa de Desencantamiento
RPG_Station_Disenchanting_Table.description = Una estación de trabajo que deshace una pieza de equipo por ritual. Devuelve lo mismo que el Banco del Chatarrero, y además Esencia de Vida y algún hallazgo ocasional.
RPG_Station_Disenchanting_Table.hint.empty = Pulsa [{key}] para colocar una pieza de equipo
RPG_Station_Disenchanting_Table.hint.loaded = Pulsa [{key}] para comenzar el ritual
RPG_Station_Disenchanting_Table.hint.working = El ritual está en curso
RPG_Station_Disenchanting_Table_Greater.name = Gran Mesa de Desencantamiento
RPG_Station_Disenchanting_Table_Greater.description = Una mesa más amplia que admite tres piezas de equipo a la vez y las trabaja en un ritual tras otro. Da más Esencia de Vida y encuentra Esencia del Vacío más a menudo.
RPG_Station_Disenchanting_Table_Greater.hint.empty = Pulsa [{key}] para colocar una pieza de equipo
RPG_Station_Disenchanting_Table_Greater.hint.loaded = Pulsa [{key}] para comenzar el ritual
RPG_Station_Disenchanting_Table_Greater.hint.working = El ritual está en curso
RPG_Weapon_Spellbook_Grimoire_Disenchanter.name = Grimorio del Desencantador
RPG_Weapon_Spellbook_Grimoire_Disenchanter.description = Un grimorio que la mesa extrajo entero de un gran número de piezas deshechas. Lanza hechizos como cualquier otro, y en la mano acelera el ritual. Las mesas no lo aceptan de vuelta.
RPG_Armor_Disenchanter_Head.name = Capucha del Desencantador
RPG_Armor_Disenchanter_Head.description = La capucha del conjunto del desencantador, de seda. Las mesas la entregan de vez en cuando. Puesta, acelera el ritual, y llevar el conjunto entero lo acelera más.
RPG_Armor_Disenchanter_Chest.name = Túnica del Desencantador
RPG_Armor_Disenchanter_Chest.description = La túnica del conjunto del desencantador, de seda, y la pieza que más aporta de las cuatro. Las mesas la entregan de vez en cuando. Puesta, acelera el ritual, y llevar el conjunto entero lo acelera más.
RPG_Armor_Disenchanter_Hands.name = Guantes del Desencantador
RPG_Armor_Disenchanter_Hands.description = Los guantes del conjunto del desencantador, de seda. Las mesas los entregan de vez en cuando. Puestos, aceleran el ritual, y llevar el conjunto entero lo acelera más.
RPG_Armor_Disenchanter_Legs.name = Calzas del Desencantador
RPG_Armor_Disenchanter_Legs.description = Las calzas del conjunto del desencantador, de seda. Las mesas las entregan de vez en cuando. Puestas, aceleran el ritual, y llevar el conjunto entero lo acelera más.
RPG_Potion_Disenchanters_Draught.name = Brebaje del Desencantador
RPG_Potion_Disenchanters_Draught.description = Esencia de Vida rebajada con un hilo de Esencia del Vacío. Bébelo y el ritual en una Mesa de Desencantamiento irá más rápido durante un tiempo.
