RPG_Station_Sawmill.name = Bıçkıhane
RPG_Station_Sawmill.description = Kütükleri tahtalara bıçkıyla kesen bir çalışma istasyonu. Çalışmaya başlamak için kullan tuşuna bas.
RPG_Station_Sawmill.hint.empty = Kütük yüklemek için [{key}] tuşuna bas
RPG_Station_Sawmill.hint.loaded = Çalışmak için [{key}] tuşuna bas
RPG_Station_MountSpike.name = Bağlantı Çıkışı (Dev)
RPG_Station_MountSpike.description = Test aracı: ayakta duran varlık bağlama çalışma duruşunu doğrular. Çalışmaya başlamak için kullan tuşuna bas.
RPG_Station_MountSpike.hint.empty = Kütük yüklemek için [{key}] tuşuna bas
RPG_Station_MountSpike.hint.loaded = Çalışmak için [{key}] tuşuna bas
RPG_Station_CuttingBoard.name = Kesme Tahtası
RPG_Station_CuttingBoard.description = Balıkları ölçekleyen ve pişmeye hazırlayan bir çalışma istasyonu. Çalışmaya başlamak için kullan tuşuna bas.
RPG_Station_CuttingBoard.hint.empty = Balık yüklemek için [{key}] tuşuna bas
RPG_Station_CuttingBoard.hint.loaded = Çalışmak için [{key}] tuşuna bas
RPG_Station_CookingFire.name = Pişirme Ateşi
RPG_Station_CookingFire.description = Çiğ balığı ateşin üzerinde ızgaralayan bir kamp ateşi. Çalışmaya başlamak için kullan tuşuna bas.
RPG_Station_CookingFire.hint.empty = Çiğ balık yüklemek için [{key}] tuşuna bas
RPG_Station_CookingFire.hint.loaded = Çalışmak için [{key}] tuşuna bas

RPG_Tool_Hatchet_Sawmiller.name = Hızarcı Baltası
RPG_Tool_Hatchet_Sawmiller.description = Sayısız hızar saatiyle dengelenmiş usta işi bir mitril balta. Dövme aslından daha keskin ve dayanıklı.
RPG_Station_CookingPit.name = Pişirme Çukuru
RPG_Station_CookingPit.description = Taşla çevrili bir kamp ateşi. Çiğ yiyecekleri açık alevde ızgara yap ya da üzerine bir kazan yerleştirip tam yemekler pişir. Çalışmaya başlamak için kullan tuşuna bas.
RPG_Station_CookingPit.hint.empty = Pişirmek için [{key}] tuşuna bas
RPG_Station_CookingPit.hint.loaded = Çalışmak için [{key}] tuşuna bas
RPG_Station_CookingPit.hint.ready = Toplamak için [{key}] tuşuna bas
RPG_Station_CookingPit.hint.overdone = Temizlemek için [{key}] tuşuna bas
RPG_Station_Cooking_Pot.name = Kazan
RPG_Station_Cooking_Pot.description = Sağlam bir demir kazan. Güveç pişirebilmek için bir pişirme çukurunun hemen üstüne yerleştir.
RPG_Food_Hearty_Stew.name = Doyurucu Güveç
RPG_Food_Hearty_Stew.description = Kazana giren her şeyden bir kâse; hepsi uyuşana dek ağır ateşte pişirilmiş. Sağlığı yeniler; et ve sebzenin gerçek karışımı hem sağlığı hem dayanıklılığı güçlendirir.
