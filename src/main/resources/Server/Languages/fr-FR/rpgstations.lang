command.validate.header = Validation de la station:
command.arg.opt = npcspike: passez 'noserialize' au démarrage pour ajouter le marqueur NonSerialized; non utilisé sinon.
command.npcspike.usage = Utilisation: /rpgstations npcspike start [noserialize] | walk | stop
command.npcspike.spawned = NPC Performer créé devant vous. Exécutez /rpgstations npcspike walk pour l'envoyer vers l'avant, stop pour le faire disparaître.
