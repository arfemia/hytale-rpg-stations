command.desc = Outils administrateur RpgStations: réglez votre preset caméra-recette de station ou validez le contenu de la station créée.
command.arg.sub = Sous-commande: camera définit/énumère votre preset caméra-recette de station; validate exécute le validateur de contenu de station.
command.arg.action = camera: un identifiant preset ou "list". Non utilisé pour validate.
command.usage = Utilisation: /rpgstations camera <preset>|list | /rpgstations validate
command.camera.usage = Utilisation: /rpgstations camera <preset>|list
