command.desc = RpgStations admin tools: tune your station camera-recipe preset or validate authored station content.
command.arg.sub = Subcommand: camera sets/lists your station camera-recipe preset; validate runs the station content validator.
command.arg.action = camera: a preset id or "list". Unused for validate.
command.usage = Usage: /rpgstations camera <preset>|list | /rpgstations validate
