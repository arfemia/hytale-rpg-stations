RPG_Station_Sawmill.name = Sägewerk
RPG_Station_Sawmill.description = Sägt Baumstämme zu Brettern. Ein besseres Beil holt aus jedem Stamm mehr Bretter heraus.
RPG_Station_Sawmill.hint.empty = Drücke [{key}] zum Laden von Baumstämmen
RPG_Station_Sawmill.hint.loaded = Drücke [{key}] zum Arbeiten
RPG_Station_MountSpike.name = Mount Spike (Dev)
RPG_Station_MountSpike.description = Wegwerfbarer Dev-Spike: überprüft die stehende Entität-Mount-Arbeitsposition.
RPG_Station_MountSpike.hint.empty = Drücke [{key}] zum Laden von Baumstämmen
RPG_Station_MountSpike.hint.loaded = Drücke [{key}] zum Arbeiten
RPG_Station_CuttingBoard.name = Zubereitungsbrett
RPG_Station_CuttingBoard.description = Eine Arbeitsstation, die Fische filetiert und sie zum Kochen vorbereitet.
RPG_Station_CuttingBoard.hint.empty = Drücke [{key}] zum Laden von Fischen
RPG_Station_CuttingBoard.hint.loaded = Drücke [{key}] zum Arbeiten
RPG_Station_CookingFire.name = Lagerfeuer
RPG_Station_CookingFire.description = Ein Lagerfeuer, das rohe Fische grillt.
RPG_Station_CookingFire.hint.empty = Drücke [{key}] zum Laden von rohen Fischen
RPG_Station_CookingFire.hint.loaded = Drücke [{key}] zum Arbeiten

RPG_Tool_Hatchet_Sawmiller.name = Sägewerker-Axt
RPG_Tool_Hatchet_Sawmiller.description = Eine meisterhafte Mithril-Axt, ausbalanciert durch ungezählte Stunden am Sägewerk. Schärfer und robuster als das Original aus der Schmiede.
RPG_Station_CookingPit.name = Kochgrube
RPG_Station_CookingPit.description = Ein steinumringtes Lagerfeuer. Grille rohe Speisen über der offenen Flamme oder setze einen Kochtopf darüber, um ganze Mahlzeiten zu kochen.
RPG_Station_CookingPit.hint.empty = Drücke [{key}] zum Kochen
RPG_Station_CookingPit.hint.loaded = Drücke [{key}] zum Arbeiten
RPG_Station_CookingPit.hint.ready = Drücke [{key}] zum Einsammeln
RPG_Station_CookingPit.hint.overdone = Drücke [{key}] zum Abräumen
RPG_Station_Cooking_Pot.name = Kochtopf
RPG_Station_Cooking_Pot.description = Ein robuster Eisentopf. Setze ihn direkt über eine Kochgrube, um Eintöpfe zu kochen.
RPG_Food_Hearty_Stew.name = Deftiger Eintopf
RPG_Food_Hearty_Stew.description = Eine Schüssel mit allem, was im Topf gelandet ist, geköchelt bis es sich verträgt. Stellt Gesundheit wieder her; eine richtige Mischung aus Fleisch und Gemüse stärkt Gesundheit und Ausdauer zugleich.
RPG_Station_Disenchanting_Table.name = Entzauberungstisch
RPG_Station_Disenchanting_Table.description = Eine Arbeitsstation, die pro Ritual ein Stück Ausrüstung zerlegt. Sie gibt zurück, was auch die Bergungswerkbank geben würde, dazu Lebensessenz und hin und wieder einen besonderen Fund.
RPG_Station_Disenchanting_Table.hint.empty = Drücke [{key}], um ein Stück Ausrüstung aufzulegen
RPG_Station_Disenchanting_Table.hint.loaded = Drücke [{key}], um das Ritual zu beginnen
RPG_Station_Disenchanting_Table.hint.working = Das Ritual läuft
RPG_Station_Disenchanting_Table_Greater.name = Großer Entzauberungstisch
RPG_Station_Disenchanting_Table_Greater.description = Ein breiterer Tisch, der drei Stücke Ausrüstung auf einmal aufnimmt und sie in einem Ritual nach dem anderen abarbeitet. Er bringt mehr Lebensessenz und findet öfter Leerenessenz.
RPG_Station_Disenchanting_Table_Greater.hint.empty = Drücke [{key}], um ein Stück Ausrüstung aufzulegen
RPG_Station_Disenchanting_Table_Greater.hint.loaded = Drücke [{key}], um das Ritual zu beginnen
RPG_Station_Disenchanting_Table_Greater.hint.working = Das Ritual läuft
RPG_Weapon_Spellbook_Grimoire_Disenchanter.name = Entzauberer-Grimoire
RPG_Weapon_Spellbook_Grimoire_Disenchanter.description = Ein Grimoire, das der Tisch als Ganzes aus sehr vielen zerlegten Stücken gezogen hat. Es wirkt Zauber wie jedes andere, und in der Hand beschleunigt es das Ritual. Die Tische nehmen es nicht zurück.
RPG_Armor_Disenchanter_Head.name = Entzauberer-Kapuze
RPG_Armor_Disenchanter_Head.description = Die Kapuze der Entzauberer-Garnitur, aus Seide. Die Tische geben sie hin und wieder heraus. Getragen beschleunigt sie das Ritual, und die ganze Garnitur zusammen beschleunigt es noch mehr.
RPG_Armor_Disenchanter_Chest.name = Entzauberer-Robe
RPG_Armor_Disenchanter_Chest.description = Die Robe der Entzauberer-Garnitur, aus Seide, und von den vier Teilen das wirkungsvollste. Die Tische geben sie hin und wieder heraus. Getragen beschleunigt sie das Ritual, und die ganze Garnitur zusammen beschleunigt es noch mehr.
RPG_Armor_Disenchanter_Hands.name = Entzauberer-Handschuhe
RPG_Armor_Disenchanter_Hands.description = Die Handschuhe der Entzauberer-Garnitur, aus Seide. Die Tische geben sie hin und wieder heraus. Getragen beschleunigen sie das Ritual, und die ganze Garnitur zusammen beschleunigt es noch mehr.
RPG_Armor_Disenchanter_Legs.name = Entzauberer-Beinkleider
RPG_Armor_Disenchanter_Legs.description = Die Beinkleider der Entzauberer-Garnitur, aus Seide. Die Tische geben sie hin und wieder heraus. Getragen beschleunigen sie das Ritual, und die ganze Garnitur zusammen beschleunigt es noch mehr.
RPG_Potion_Disenchanters_Draught.name = Entzauberer-Trank
RPG_Potion_Disenchanters_Draught.description = Lebensessenz, versetzt mit einem Faden Leerenessenz. Trink ihn, und das Ritual an einem Entzauberungstisch läuft eine Weile schneller.
