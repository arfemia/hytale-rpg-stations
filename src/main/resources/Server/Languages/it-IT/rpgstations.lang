command.desc = Strumenti admin RpgStations: personalizza il tuo preset macchina fotografica della stazione o convalida il contenuto della stazione autorizzato.
command.arg.sub = Sottocomando: camera imposta/elenca il tuo preset della macchina fotografica della stazione; validate esegue il validatore del contenuto della stazione.
command.arg.action = camera: un id preset o "list". Non usato per validate.
command.usage = Utilizzo: /rpgstations camera <preset>|list | /rpgstations validate
